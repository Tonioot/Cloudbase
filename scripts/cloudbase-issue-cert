#!/usr/bin/env bash
# Manage Let's Encrypt certificates for Cloudbase.
#
#   cloudbase-issue-cert issue <cert-name> <email|-> <domain> [domain ...]
#       Request a certificate, or change the names on an existing one
#       (same cert-name keeps the same /etc/letsencrypt/live/<cert-name>/ paths).
#   cloudbase-issue-cert delete <cert-name>
#       Remove a certificate that is no longer used.
#
# Installed root-owned to /usr/local/lib/cloudbase/issue-cert; Cloudbase may run
# it through sudo without a password. It only ever calls certbot in webroot
# mode or certbot delete, so every argument is validated strictly.
set -euo pipefail

WEBROOT="/var/www/cloudbase/acme"
DOMAIN_RE='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$'

die() { echo "error: $*" >&2; exit 2; }
valid_domain() { [[ ${#1} -le 253 && "$1" =~ $DOMAIN_RE ]]; }

command -v certbot >/dev/null 2>&1 || die "certbot is not installed (run: cloudbase update)"
[[ $# -ge 2 ]] || die "usage: cloudbase-issue-cert issue <cert-name> <email|-> <domain>... | delete <cert-name>"

action="$1"; cert_name="$2"; shift 2
valid_domain "$cert_name" || die "invalid certificate name: $cert_name"

case "$action" in
  delete)
    exec certbot delete --cert-name "$cert_name" --non-interactive
    ;;
  issue)
    [[ $# -ge 2 ]] || die "usage: cloudbase-issue-cert issue <cert-name> <email|-> <domain>..."
    email="$1"; shift
    [[ $# -le 10 ]] || die "at most 10 names per certificate"
    for d in "$@"; do valid_domain "$d" || die "invalid domain: $d"; done

    args=(certonly --webroot -w "$WEBROOT" --non-interactive --agree-tos --keep-until-expiring
          --cert-name "$cert_name" --deploy-hook "systemctl reload nginx")
    if [[ "$email" == "-" ]]; then
      args+=(--register-unsafely-without-email)
    else
      [[ ${#email} -le 254 && "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,63}$ ]] || die "invalid email address"
      args+=(-m "$email")
    fi
    for d in "$@"; do args+=(-d "$d"); done

    mkdir -p "$WEBROOT/.well-known/acme-challenge"
    exec certbot "${args[@]}"
    ;;
  *)
    die "unknown action: $action"
    ;;
esac
